# New standalone application only. Never use Employer Intelligence credentials.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
APP_ORIGINS=http://localhost:5173
# Comma-separated stable Clerk user IDs. Used only to initialise administrators.
BOOTSTRAP_ADMIN_IDS=
DATABASE_URL=
DATABASE_CONFIRMED_STANDALONE=false
LOCAL_DATA_DIR=.data/research
PORT=3001
# Production requires a clamdscan-compatible executable receiving stdin.
UPLOAD_SCAN_COMMAND=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Supply exact provider API model IDs available to your account.
# Product names and Codex model identifiers are not assumed to be API IDs.
ECONOMY_MODEL=
POWER_MODEL=
MAX_CLAUDE_MODEL=
MAX_OPENAI_MODEL=
