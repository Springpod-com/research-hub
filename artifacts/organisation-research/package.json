{
  "name": "@workspace/organisation-research",
  "version": "1.0.0",
  "description": "Standalone Springpod organisation and role research workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"PORT=3001 tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "build:production": "pnpm run build && pnpm run audit",
    "start": "scripts/start-production.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "springpod-audit src",
    "occupations:import": "tsx scripts/occupations/import.mts",
    "registry:heartbeat": "tsx scripts/registry-heartbeat.ts",
    "demo": "concurrently -k \"tsx tests/preview-server.ts\" \"vite --host 127.0.0.1\"",
    "scanner": "scripts/clamav/clamav-daemon.sh"
  },
  "dependencies": {
    "@clerk/express": "2.1.67",
    "@clerk/react": "6.15.2",
    "@clerk/shared": "4.31.1",
    "@electric-sql/pglite": "0.5.8",
    "@springpod/design-system": "0.2.0",
    "cheerio": "1.2.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "http-proxy-middleware": "4.2.0",
    "ipaddr.js": "2.5.0",
    "jszip": "3.10.2",
    "mammoth": "1.12.3",
    "multer": "2.4.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "undici": "8.10.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.5",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
