modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"
ignorePorts = false

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["clamav"]

[userenv]

[userenv.shared]
DATABASE_CONFIRMED_STANDALONE = "true"
RESEARCH_MODEL = "claude-sonnet-5"
BOOTSTRAP_ADMIN_EMAILS = "oliver.fisher@springpod.com"

[userenv.production]
UPLOAD_SCAN_COMMAND = "scripts/clamav/scan-upload.sh"
